# Copy to .env and fill in. Every key is optional (see README > Run locally).
# PayPal Developer Dashboard > Apps & Credentials > Sandbox > your app.
# The server creates, captures and refunds orders with these. Leave empty for demo payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# Anthropic API key for the AI quote assistant. Without it the assistant shows "offline".
ANTHROPIC_API_KEY=
# Optional: model and daily call cap (cost guard).
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=300

# Supabase (Project Settings > API Keys and > Data API). Without these the server keeps data in memory.
# Create the tables once with supabase/schema.sql (SQL Editor > New query > Run).
SUPABASE_URL=
# The secret key (sb_secret_...). Server only: it bypasses row level security.
SUPABASE_SECRET_KEY=
# The publishable key (sb_publishable_...). Turns on owner sign-in for the dashboard.
SUPABASE_PUBLISHABLE_KEY=
# Password for the shared demo owner ("Use the demo account"). Any random string of 8+ characters.
# The server creates the account on start and resets the password if a visitor changes it.
DEMO_OWNER_PASSWORD=
