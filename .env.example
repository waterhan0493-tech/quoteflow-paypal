# Copy to .env and fill in. Every key is optional (see README > Run locally).
# PayPal Developer Dashboard > Apps & Credentials > Sandbox > your app > Client ID.
# Leave empty to run in demo mode (a simulated deposit button instead of PayPal).
VITE_PAYPAL_CLIENT_ID=

# ---- Server only (npm run server / Render). Never prefix these with VITE_. ----
# Anthropic API key for the AI quote assistant. Without it the assistant shows "offline".
ANTHROPIC_API_KEY=
# Optional: model and daily call cap (cost guard).
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=300

# Supabase (Project Settings > API Keys and > Data API). Without these the server keeps data in memory.
# Create the tables once with supabase/schema.sql (SQL Editor > New query > Run).
SUPABASE_URL=
# The secret key (sb_secret_...). Server only: it bypasses row level security.
SUPABASE_SECRET_KEY=
